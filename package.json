{
  "name": "lietner",
  "private": true,
  "version": "0.1.0",
  "description": "Leitner-system flashcards on a 3D desk. Free, local-first, optional sync.",
  "license": "MIT",
  "homepage": "https://lietner.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ELTIGA/lietner.git"
  },
  "bugs": {
    "url": "https://github.com/ELTIGA/lietner/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:db": "supabase test db",
    "test:integration": "sh -c 'set -a; eval \"$(supabase status -o env)\"; set +a; vitest run src/sync/supabase.integration.test.ts'",
    "icons": "pwa-assets-generator"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@sentry/browser": "^11.6.0",
    "@supabase/supabase-js": "^2.117.3",
    "@vercel/analytics": "^2.0.1",
    "gsap": "^3.15.0",
    "idb": "^8.0.4",
    "papaparse": "^5.7.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/three": "^0.186.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "fake-indexeddb": "^6.2.5",
    "supabase": "^2.120.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1"
  }
}
