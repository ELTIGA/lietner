{
  "name": "lietner",
  "private": true,
  "version": "0.1.0",
  "description": "Leitner-system flashcards on a 3D desk. Free, local-first, optional sync.",
  "license": "MIT",
  "homepage": "https://lietner.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ELTIGA/lietner.git"
  },
  "bugs": {
    "url": "https://github.com/ELTIGA/lietner/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:db": "supabase test db",
    "test:integration": "sh -c 'set -a; eval \"$(supabase status -o env)\"; set +a; vitest run src/sync/supabase.integration.test.ts'"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "gsap": "^3.15.0",
    "idb": "^8.0.4",
    "papaparse": "^5.7.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "@types/three": "^0.186.0",
    "fake-indexeddb": "^6.2.5",
    "supabase": "^2.120.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
