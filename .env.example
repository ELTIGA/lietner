# Copy to .env.local for local development. Every variable is optional:
# with none set, Lietner runs guest-only (IndexedDB, no sign-in, no telemetry).
#
# Local Supabase: run `npx supabase start`, then copy "API URL" and the
# publishable (anon) key from `npx supabase status`.
#
# NEVER put the Supabase secret / service-role key here or anywhere in the
# client or the repo. It bypasses row-level security.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Google sign-in (ID-token flow). Works only on https://lietner.app and http://localhost:5173.
VITE_GOOGLE_CLIENT_ID=

# Sentry, EU region. Leave empty locally.
VITE_SENTRY_DSN=
